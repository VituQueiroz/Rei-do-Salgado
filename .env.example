# Crie um arquivo .env com a seguinte variável e defina o número real do WhatsApp da lanchonete
# Formato: código do país + DDD + número (sem espaços ou símbolos)
VITE_WHATSAPP_NUMBER=

# Supabase (banco de dados + login do administrador)
# Encontre em: Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
